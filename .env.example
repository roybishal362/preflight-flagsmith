# Copy to .env and fill in. Never commit .env.
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1/
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_KEY=
# Organisation API key (Organisation Settings > API Keys). Needed for `preflight check` and `preflight verdict`.
# Environment key of a separate TEST environment for `preflight smoke`.
FLAGSMITH_SMOKE_ENVIRONMENT_KEY=
